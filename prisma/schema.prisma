// Prisma schema for HyzenPro - MongoDB
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// AI TOOLS
// ==========================================

model Tool {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  slug             String   @unique
  shortDescription String
  longDescription  String
  websiteUrl       String
  pricingType      String   @default("freemium") // free, freemium, paid, enterprise
  status           String   @default("published") // published, draft
  logo             String?
  featured         Boolean  @default(false)
  views            Int      @default(0)
  helpfulCount     Int      @default(0)
  features         String[]
  pros             String[]
  cons             String[]
  categoryIds      String[] @db.ObjectId
  categories       Category[] @relation(fields: [categoryIds], references: [id])
  primaryCategory  String?  // slug of the primary category for URL
  alternativeIds   String[] @db.ObjectId
  personaPageIds   String[] @db.ObjectId
  personaPages     PersonaPage[] @relation(fields: [personaPageIds], references: [id])
  rating           Float?
  meta             Json?    // Flexible metadata
  seo              Seo?
  submittedById    String?  @db.ObjectId
  savedByUserIds   String[] @db.ObjectId
  savedByUsers     User[]   @relation(fields: [savedByUserIds], references: [id])
  translations     ToolTranslation[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Category {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  slug            String   @unique
  parentId        String?  @db.ObjectId
  description     String?
  longDescription String?
  seoContent      String?
  icon            String?
  iconClass       String?
  toolCount       Int      @default(0)
  toolIds         String[] @db.ObjectId
  tools           Tool[]   @relation(fields: [toolIds], references: [id])
  seo             Seo?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  translations    CategoryTranslation[]
}

// ==========================================
// PERSONA PAGES (6 audience-segmented directory pages)
// ==========================================

model PersonaPage {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String                    // "Creators & YouTubers"
  slug            String   @unique          // "creators-youtubers"
  status          String   @default("draft") // draft, published, scheduled

  // Hero Section
  heroTitle       String?                   // H1 heading
  heroSubtitle    String?                   // Body content (~400 words)
  heroImage       String?                   // Featured image URL

  // SEO
  metaTitle       String?                   // ≤60 chars
  metaDescription String?                   // ≤155 chars
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  focusKeyword    String?

  // Content Sections (JSON for flexibility)
  painPoints      Json?                     // [{title, description, icon}]
  workflowSteps   Json?                     // [{step, title, description}]
  starterKit      Json?                     // [{toolId, note}] — curated top picks
  faq             Json?                     // [{question, answer}]
  internalLinks   Json?                     // [{label, href}]
  crossLinks      Json?                     // [{label, href, description}]

  // CTA
  ctaText         String?                   // "Browse all AI Video Tools →"
  ctaUrl          String?                   // "/ai-tools-directory/ai-video-tools/"

  // Display Control
  sortOrder       Int      @default(0)
  featuredImage   String?

  // Tool Assignment (many-to-many)
  toolIds         String[] @db.ObjectId
  tools           Tool[]   @relation(fields: [toolIds], references: [id])

  // Timestamps
  publishedAt     DateTime?
  scheduledAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  translations    PersonaPageTranslation[]

  @@index([status])
}

// ==========================================
// BLOG
// ==========================================

model Post {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String    @unique
  excerpt       String?
  content       String    // HTML content
  featuredImage String?
  categories    String[]  // category slugs
  tags          String[]
  author        String    @default("HyzenPro Team") // legacy simple string
  authorId      String?   @db.ObjectId
  authorModel   Author?   @relation(fields: [authorId], references: [id])
  status        String    @default("draft") // draft, published, scheduled, trash
  postType      String    @default("post") // post, review, comparison, tutorial, page
  seo           Seo?
  views         Int       @default(0)
  readingTime   Int?      // estimated minutes to read
  publishedAt   DateTime?
  scheduledAt   DateTime? // for scheduled publishing
  trashedAt     DateTime? // soft-delete timestamp
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  revisions     PostRevision[]
  translations  PostTranslation[]
}

model PostRevision {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @db.ObjectId
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  title     String
  content   String
  excerpt   String?
  author    String   @default("HyzenPro Team")
  reason    String?  // optional revision note
  wordCount Int?
  createdAt DateTime @default(now())
}

// ==========================================
// REVIEWS (standalone review pages)
// ==========================================

model Review {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  toolSlug    String
  toolName    String
  title       String
  slug        String    @unique
  content     String
  rating      Float
  pros        String[]
  cons        String[]
  verdict     String?
  author      String    @default("HyzenPro Team")
  status      String    @default("draft")
  seo         Seo?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ==========================================
// AUTH
// ==========================================

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  password      String    // bcrypt hashed
  role          String    @default("admin")
  image         String?
  savedToolIds  String[]  @db.ObjectId
  savedTools    Tool[]    @relation(fields: [savedToolIds], references: [id])
  stackName     String?   
  isStackPublic Boolean   @default(true)
  isTwoFactorEnabled Boolean @default(false)
  twoFactorSecret    String?
  mustChangePassword Boolean @default(false)
  failedSignInAttempts Int   @default(0)
  lockoutUntil        DateTime?
  passwordChangedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// AUTHORS (For Blog/Reviews)
// ==========================================

model Author {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  role        String?
  bio         String?
  image       String?
  socialLinks Json?    // { twitter, linkedin, website }
  posts       Post[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// MEDIA LIBRARY
// ==========================================

model MediaAsset {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  originalFileName String
  fileName         String
  slug             String
  contentType      String
  extension        String
  size             Int
  width            Int?
  height           Int?
  title            String?
  altText          String?
  caption          String?
  description      String?
  focusKeyword     String?
  metaTitle        String?
  metaDescription  String?
  uploadedById     String?  @db.ObjectId
  uploadedByEmail  String?
  r2Key            String?
  r2Url            String?
  data             Bytes?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ==========================================
// CTA (Reusable Call-to-Action blocks for blog posts)
// ==========================================

model CTA {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique  // internal label
  slug        String   @unique  // shortcode reference
  headline    String?  // CTA heading text
  description String?  // CTA body text
  buttonText  String   // e.g. "Try Free" or "Get 50% Off"
  buttonUrl   String   // affiliate or destination URL
  style       String   @default("default") // default, highlight, banner, minimal
  isActive    Boolean  @default(true)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// SITE CONTENT (Dashboard-editable homepage sections)
// ==========================================

model SiteContent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  sectionId String   @unique // e.g. "hero", "stats", "social-proof", "cta"
  title     String?
  subtitle  String?
  content   Json?    // Flexible JSON for section-specific data
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model MatcherLead {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  email      String
  name       String?
  category   String
  resultId   String
  resultName String
  source     String   @default("matcher-result")
  answers    Json?
  createdAt  DateTime @default(now())
}

// ==========================================
// TRANSLATION MODELS
// ==========================================

model ToolTranslation {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  toolId          String   @db.ObjectId
  tool            Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  locale          String   // "en", "es", "de", etc.
  name            String
  shortDescription String
  longDescription  String
  websiteUrl       String
  metaTitle       String?
  metaDescription String?
  status          String   @default("draft") // draft | ai_translated | reviewed | published
  translatedAt    DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?

  @@unique([toolId, locale])
}

model PostTranslation {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  postId        String   @db.ObjectId
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  locale        String   // "en", "es", "de", etc.
  title         String
  excerpt       String?
  content       String
  metaTitle     String?
  metaDescription String?
  status        String   @default("draft") // draft | ai_translated | reviewed | published
  translatedAt  DateTime?
  reviewedBy    String?
  reviewedAt    DateTime?

  @@unique([postId, locale])
}

model CategoryTranslation {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  categoryId      String   @db.ObjectId
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale          String   // "en", "es", "de", etc.
  name            String
  description     String?
  longDescription String?
  seoContent      String?
  metaTitle       String?
  metaDescription String?
  status          String   @default("draft") // draft | ai_translated | reviewed | published
  translatedAt    DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?

  @@unique([categoryId, locale])
}

model PersonaPageTranslation {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  personaPageId   String   @db.ObjectId
  personaPage     PersonaPage @relation(fields: [personaPageId], references: [id], onDelete: Cascade)
  locale          String   // "en", "es", "de", etc.
  heroTitle       String?
  heroSubtitle    String?
  metaTitle       String?
  metaDescription String?
  ogTitle         String?
  ogDescription   String?
  status          String   @default("draft") // draft | ai_translated | reviewed | published
  translatedAt    DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?

  @@unique([personaPageId, locale])
}

// ==========================================
// ACTIVITY LOG (Audit Trail)
// ==========================================

model ActivityLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String?  @db.ObjectId
  userName    String?
  action      String   // create, update, delete, login, logout, publish, unpublish
  entityType  String   // tool, post, category, persona-page, user, setting, media
  entityId    String?  @db.ObjectId
  entityName  String?
  details     Json?    // { before: ..., after: ... } or { reason: ... }
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ==========================================
// EMBEDDED TYPES
// ==========================================

type Seo {
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?
  ogTitle         String?
  ogDescription   String?
  twitterCard     String?  // summary, summary_large_image
  noIndex         Boolean?
  focusKeyword    String?
}
