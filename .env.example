# Database (never commit real values)
# Atlas users: append ?connectTimeoutMS=5000&serverSelectionTimeoutMS=5000 to the URL for fast-fail during outages
DATABASE_URL=

# Maintenance mode: set to "true" to serve a 503 maintenance page on all public
# routes (admin/api stay accessible). Set to "false" or remove to bring site back.
MAINTENANCE_MODE=false

# Site
NEXT_PUBLIC_SITE_URL=https://hyzenpro.com
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-MVKBDMQ060
NEXT_PUBLIC_GTM_ID=GTM-NKKSJM9M

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET=
NEXTAUTH_URL=https://hyzenpro.com

# Admin bootstrap (local seed only)
ADMIN_BOOTSTRAP_PASSWORD=

# On-demand ISR revalidation
REVALIDATION_SECRET=

# Cron (publish-scheduled endpoint auth)
CRON_SECRET=

# Cloudflare R2 (media storage)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Contact form recipient
CONTACT_EMAIL=

# IndexNow (search engine ping)
INDEXNOW_KEY=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Resend (contact form emails) — https://resend.com
RESEND_API_KEY=

# Cloudflare Turnstile (vendor submissions) — https://dash.cloudflare.com/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry (optional)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
